{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox-soft-dark",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "terminal": {
    "title": true
  },
  "tabs": {
    "layout": "horizontal"
  },
  "keybinds": {
    "agent.cycle": "tab",
    "session.tab.previous": "ctrl+shift+tab,ctrl+left",
    "session.tab.next": "ctrl+tab,ctrl+right",
    "input.word.backward": "alt+b,alt+left",
    "input.word.forward": "alt+f,alt+right"
  }
}

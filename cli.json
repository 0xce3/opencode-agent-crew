{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox-soft-dark",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "terminal": {
    "title": true
  },
  "tabs": {
    "layout": "horizontal"
  },
  "keybinds": {
    "agent.cycle": "tab"
  }
}

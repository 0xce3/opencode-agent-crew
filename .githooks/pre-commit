#!/usr/bin/env sh
set -eu

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks_bin="$(command -v gitleaks)"
elif [ -x "$HOME/.local/bin/gitleaks" ]; then
  gitleaks_bin="$HOME/.local/bin/gitleaks"
else
  echo "gitleaks is required for commits. Install it, then retry." >&2
  exit 1
fi

exec "$gitleaks_bin" git --staged --redact=100 --no-banner
